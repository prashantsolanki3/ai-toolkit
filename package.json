{
  "name": "ai-toolkit",
  "version": "1.0.0",
  "description": "Tool-agnostic CLI that installs and updates skills, agents, commands, and hooks across AI coding tools",
  "type": "module",
  "bin": {
    "ai-toolkit": "./bin/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
