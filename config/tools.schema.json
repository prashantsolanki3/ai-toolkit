{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai-toolkit tools config",
  "type": "object",
  "required": ["version", "tools"],
  "properties": {
    "version": { "type": "string" },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "displayName",
          "defaultTarget",
          "assetPaths",
          "assetFormats",
          "supportedAssets"
        ],
        "properties": {
          "displayName": { "type": "string" },
          "defaultTarget": {
            "type": "object",
            "required": ["global", "workspace"],
            "properties": {
              "global": { "type": ["string", "null"] },
              "workspace": { "type": ["string", "null"] }
            }
          },
          "assetPaths": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "assetFormats": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["filename", "type"],
              "properties": {
                "filename": { "type": "string" },
                "type": { "enum": ["directory", "file"] },
                "sourceFile": {
                  "type": "string",
                  "description": "When converting a directory-format source to a file-format destination, the relative path inside the source dir to copy."
                },
                "frontmatter": {
                  "type": "object",
                  "description": "Optional frontmatter template written to the destination. Values may be literals or {sourceKey} template strings. When set, the source frontmatter is parsed, this template is built (with substitutions and per-asset overrides), and the result is prepended to the body. Use this for tools like Cursor (.mdc) and VS Code Copilot (.instructions.md) that expect their own frontmatter contract.",
                  "additionalProperties": true
                },
                "sidecar": {
                  "type": "object",
                  "description": "Optional sibling file generated alongside the asset (e.g. .kiro.hook JSON for a Kiro hook script).",
                  "required": ["filename", "format", "content"],
                  "properties": {
                    "filename": { "type": "string" },
                    "format": { "enum": ["json"] },
                    "content": { "type": "object" }
                  }
                }
              }
            }
          },
          "notes": {
            "type": "string",
            "description": "Optional notes about the tool — useful when its asset model is uncertain or has caveats."
          },
          "supportedAssets": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          }
        }
      }
    }
  }
}
