# Copy this file to .env (next to bc_auth.py) and fill in real values.
# .env is gitignored — never commit the real secret.
#
# Pick the env+company pair for the backend you're testing against:
#   dev backend  →  BC_ENVIRONMENT=Ext_Dev_v26      BC_COMPANY_ID=<guid of "CRONUS DE">
#   prod backend →  BC_ENVIRONMENT=SmartAgents_Prod BC_COMPANY_ID=<guid of "smart-agents-prod">
#
# Resolve company GUIDs once with:
#   python -c "from bc_auth import BCClient; c=BCClient(); [print(co['name'], co['id']) for co in c.get_all('companies')]"

BC_TENANT_ID=80189abf-5929-4f1c-9c77-e8a43717d27e
BC_CLIENT_ID=<entra-app-registration-client-id>
BC_CLIENT_SECRET=<entra-app-registration-client-secret>
BC_ENVIRONMENT=Ext_Dev_v26
BC_COMPANY_ID=<companyId-guid>
